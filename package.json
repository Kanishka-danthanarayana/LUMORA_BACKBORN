{
  "name": "lumora-backborn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "build:exe": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.lumora.backborn",
    "productName": "Lumora Backborn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-zoom-pan-pinch": "^4.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.4"
  }
}
